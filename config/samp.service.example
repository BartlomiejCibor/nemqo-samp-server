[Unit]
Description=NEMQO SA-MP Freeroam + Deathmatch
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=samp
Group=samp
WorkingDirectory=/opt/nemqo-samp/server
ExecStart=/opt/nemqo-samp/server/samp03svr
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/nemqo-samp/server
MemoryMax=512M
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
