# Compiled binaries and official server executables
*.amx
samp03svr
samp-npc
announce
plugins/*.so

# The two reviewed prebuilt AMX files are intentionally distributable.
!server-files/gamemodes/nemqo_freeroam_dm.amx
!server-files/npcmodes/ambient_walk.amx

# Runtime configuration and secrets
server.cfg
server-*.cfg
.env
.env.*
*.pem
*.key
id_rsa*
id_ed25519*
authorized_keys

# Sanitized templates are safe to track.
!config/server.cfg.example
!server-files/server.cfg.example

# Player data and SQLite runtime files
scriptfiles/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Only brand-new databases generated from database/schema.sql are allowed.
!database/accounts.clean.db
!server-files/scriptfiles/accounts.db

# Logs, crashes and process state
*.log
server_log.txt
crashinfo.txt
core
core.*
*.pid

# Local builds, staging, backups and archives
build/
dist/
releases/
staging/
backups/
*.tar
*.tar.gz
*.tgz
*.zip

# Temporary/editor files
*.tmp
*.swp
*~
.DS_Store
.vscode/
.idea/
__pycache__/
*.pyc

# Local deployment scripts and credentials
deploy-local*.sh
credentials/
secrets/
