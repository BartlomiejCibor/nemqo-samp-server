stock Island_RunSelfTest()
{
    new failures=0, houses=0, interiors=0, tower=0;
    if(g_IslandObjectCount!=ISLAND_EXPECTED_OBJECTS || g_IslandVehicleCount!=ISLAND_VEHICLES) failures++;
    new Float:x,Float:y,Float:z;
    for(new i=0;i<g_IslandObjectCount;i++)
    {
        if(!IsValidObject(g_IslandObjects[i])) { failures++; continue; }
        GetObjectPos(g_IslandObjects[i],x,y,z);
        if(floatabs(x-g_IslandObjectPos[i][0])>0.02 || floatabs(y-g_IslandObjectPos[i][1])>0.02 || floatabs(z-g_IslandObjectPos[i][2])>0.02) failures++;
        GetObjectRot(g_IslandObjects[i],x,y,z);
        if(floatabs(x-g_IslandObjectRot[i][0])>0.02 || floatabs(y-g_IslandObjectRot[i][1])>0.02 || floatabs(z-g_IslandObjectRot[i][2])>0.02) failures++;
        switch(g_IslandObjectModel[i])
        {
            case 19499,19505,19507,19509,19511:
            {
                houses++;
                if(i+1>=g_IslandObjectCount) { failures++; continue; }
                if(g_IslandObjectModel[i+1]!=g_IslandObjectModel[i]+1) failures++;
                for(new axis=0;axis<3;axis++)
                    if(floatabs(g_IslandObjectPos[i][axis]-g_IslandObjectPos[i+1][axis])>0.001 || floatabs(g_IslandObjectRot[i][axis]-g_IslandObjectRot[i+1][axis])>0.001) failures++;
            }
            case 19500,19506,19508,19510,19512: interiors++;
            case 3279: tower++;
        }
    }
    if(houses!=9 || interiors!=9 || tower!=1) failures++;
    for(new i=0;i<g_IslandVehicleCount;i++)
        if(g_IslandVehicles[i]==INVALID_VEHICLE_ID || GetVehicleModel(g_IslandVehicles[i])==0) failures++;
    if(failures) { printf("NEMQO Island self-test: FAIL failures=%d",failures); SendRconCommand("exit"); return 0; }
    printf("NEMQO Island self-test: PASS | grove-v3 objects=%d houses=9 interiors=9 pairs=verified tower=3279 vehicles=%d positions=verified",g_IslandObjectCount,g_IslandVehicleCount);
    return 1;
}

stock Island_Teleport(playerid)
{
    if (g_PSZHideJoined[playerid]) PSZ_LeaveHide(playerid, false);
    if (g_InDM[playerid] || g_InSumo[playerid] || V4_IsInArena(playerid))
        CallLocalFunction("OnPlayerCommandText", "is", playerid, "/freeroam");

    PSZ_DisableDrift(playerid);
    g_InDM[playerid] = false;
    g_InSumo[playerid] = false;
    SetPlayerVirtualWorld(playerid, 0);
    SetPlayerInterior(playerid, 0);

    if (IsPlayerInAnyVehicle(playerid) && GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
    {
        new vehicleid = GetPlayerVehicleID(playerid);
        LinkVehicleToInterior(vehicleid, 0);
        SetVehicleVirtualWorld(vehicleid, 0);
        SetVehiclePos(vehicleid, ISLAND_SPAWN_X, ISLAND_SPAWN_Y, ISLAND_SPAWN_Z);
        SetVehicleZAngle(vehicleid, ISLAND_SPAWN_A);
    }
    else
    {
        if (IsPlayerInAnyVehicle(playerid)) RemovePlayerFromVehicle(playerid);
        SetPlayerPos(playerid, ISLAND_SPAWN_X, ISLAND_SPAWN_Y, ISLAND_SPAWN_Z);
        SetPlayerFacingAngle(playerid, ISLAND_SPAWN_A);
    }
    SetCameraBehindPlayer(playerid);
    GameTextForPlayer(playerid, "~y~GROVE ISLAND~n~~w~9 domow  Plac  Plaza  Pomost", 4000, 3);
    SendClientMessage(playerid, COLOR_YELLOW, "Grove Island: 9 domow z wnetrzami, ulica i plac, plaza i pomost. Powrot: /molo.");
    return 1;
}

stock Island_OnCommandText(playerid, cmdtext[])
{
    if (!strcmp(cmdtext, "/wyspa", true) || !strcmp(cmdtext, "/island", true))
        return Island_Teleport(playerid), 1;
    return 0;
}

stock Island_Destroy()
{
    for (new i = 0; i < g_IslandObjectCount; i++)
    {
        if (IsValidObject(g_IslandObjects[i])) DestroyObject(g_IslandObjects[i]);
        g_IslandObjects[i] = INVALID_OBJECT_ID;
    }
    for (new i = 0; i < g_IslandVehicleCount; i++)
    {
        if (g_IslandVehicles[i] != INVALID_VEHICLE_ID) DestroyVehicle(g_IslandVehicles[i]);
        g_IslandVehicles[i] = INVALID_VEHICLE_ID;
    }
    Delete3DTextLabel(g_IslandWelcomeLabel);
    g_IslandObjectCount = 0;
    g_IslandVehicleCount = 0;
    return 1;
}
